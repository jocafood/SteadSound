<file path="backend/scripts/sync_metadata.py">
"""Sincroniza los textos de metadata.json con el catálogo sin modificar archivos de imagen."""
import json
from pathlib import Path

from core.catalog import DATA, ImageRecord, load_catalog

METADATA_FIELDS = {"id", "title", "description", "altText", "sourceUrl", "credit", "category"}


def sync_metadata(data: Path = DATA) -> int:
    # Comprobar archivos y formatos antes de tocar el índice.
    catalog = load_catalog(data)
    rows = []
    for record in catalog.values():
        path = data / "images" / record.id / "metadata.json"
        metadata = json.loads(path.read_text(encoding="utf-8"))
        if set(metadata) != METADATA_FIELDS:
            raise ValueError(f"{path}: se requieren únicamente los campos {sorted(METADATA_FIELDS)}")
        if metadata["id"] != record.id:
            raise ValueError(f"{path}: el id no coincide con la carpeta y el catálogo.")
        updated = ImageRecord.model_validate({**record.model_dump(mode="json"), **metadata})
        rows.append(updated.model_dump(mode="json"))
    # Validar todos los metadatos antes de reemplazar el catálogo.
    destination = data / "catalog.json"
    temporary = destination.with_suffix(".tmp")
    temporary.write_text(json.dumps(rows, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temporary.replace(destination)
    return len(rows)


if __name__ == "__main__":
    print(f"Metadatos sincronizados: {sync_metadata()}")
</file>

<file path="backend/scripts/verify_catalog.py">
"""Verifica archivos, metadatos y correspondencia de carpetas del catálogo local."""
import json
from pathlib import Path

from core.catalog import DATA, load_catalog
from scripts.sync_metadata import METADATA_FIELDS


def verify_catalog(data: Path = DATA) -> int:
    catalog = load_catalog(data)
    folders = {p.name for p in (data / "images").iterdir() if p.is_dir()}
    if folders != set(catalog):
        raise ValueError(f"Carpetas fuera del catálogo: {sorted(folders - set(catalog))}; faltantes: {sorted(set(catalog) - folders)}")
    for record in catalog.values():
        metadata_path = data / "images" / record.id / "metadata.json"
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        expected = {key: value for key, value in record.model_dump(mode="json").items() if key in METADATA_FIELDS}
        if metadata != expected:
            raise ValueError(f"{record.id}: metadata.json y catálogo difieren; ejecute python -m scripts.sync_metadata.")
    return len(catalog)


if __name__ == "__main__":
    print(f"Catálogo verificado: {verify_catalog()} imágenes")
</file>

