const imagenes = [
  'frontend/assets/placeholders/1.png',
  'frontend/assets/placeholders/2.png',
  'frontend/assets/placeholders/3.png',
  'frontend/assets/placeholders/4.png',
  'frontend/assets/placeholders/5.png',
];

const contenedor = document.querySelector('.discos');
const spotlight = document.getElementById('spotlight');
let activo = 0;

function render() {
  contenedor.querySelectorAll('.disco').forEach((disco, i) => {
    disco.classList.toggle('activo', i === activo);
  });
  spotlight.innerHTML = `<img src="${imagenes[activo]}" alt="">`;
}

imagenes.forEach((src, i) => {
  const disco = document.createElement('div');
  disco.classList.add('disco');
  disco.innerHTML = `<img src="${src}" alt="">`;
  disco.addEventListener('click', () => {
    activo = i;
    render();
  });
  contenedor.appendChild(disco);
});

document.getElementById('prev').addEventListener('click', () => {
  activo = (activo - 1 + imagenes.length) % imagenes.length;
  render();
});

document.getElementById('next').addEventListener('click', () => {
  activo = (activo + 1) % imagenes.length;
  render();
});

render();
