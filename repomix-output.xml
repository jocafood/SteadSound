export const INSTRUMENTS = Object.freeze(['piano', 'violin', 'flute', 'bell', 'guitar']);
let instruments = ['piano'];
let rhythm = imageRhythm([]);
export function configurarImagen(samples) { rhythm = imageRhythm(samples); return { ...rhythm }; }
