  assert.equal(colorToSound({ r: 0, g: 0, b: 255 }).hue, 240);
  assert.equal(colorToSound({ r: 255, g: 0, b: 255 }).hue, 300);
  assert.notEqual(colorToSound({ r: 255, g: 0, b: 0 }).frequency, colorToSound({ r: 0, g: 0, b: 255 }).frequency);
